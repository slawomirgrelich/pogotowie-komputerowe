                const tomorrowInfo = CONFIG.schedule[tomorrowDay];
                if (badge) {
                    badge.className = "inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-[#1e293b] border border-amber-500/40 text-xs sm:text-sm font-bold text-white shadow-md";
