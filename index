                label: "Naprawa zawiasów / obudowy / klawiatury (180–280 zł + części)",
                priceText: "180–280 zł + koszt części",
                over200: true,
                isRemoteService: false
            },
            pcbuild: {
                label: "Złożenie PC od zera (250–350 zł)",
                priceText: "250–350 zł",
                over200: true,
                isRemoteService: false
            }
        };

        function appendSymptom(snippet) {
            const textarea = document.getElementById('calc-symptoms');
            if (!textarea) return;
            const current = textarea.value.trim();
            if (!current) {
                textarea.value = snippet;
            } else if (!current.includes(snippet)) {
                textarea.value = `${current}; ${snippet}`;
            }
            updateCalculator();
        }

        function buildMessageData() {
            const serviceKey = document.getElementById('calc-service')?.value || 'remote';
            const citySelect = document.getElementById('calc-city');
            const cityName = citySelect?.value || 'Mikołów';
            const cityZone = citySelect?.options[citySelect.selectedIndex]?.getAttribute('data-zone') || 'mikolow';
            const symptoms = document.getElementById('calc-symptoms')?.value.trim() || '';

            const serviceObj = SERVICE_PRICING[serviceKey] || SERVICE_PRICING.remote;

            // Wyliczenie kosztu dojazdu
            let travelText = "";
            if (serviceObj.isRemoteService || cityZone === 'remote') {
                travelText = "0 zł (połączenie zdalne przez internet)";
            } else if (cityZone === 'mikolow') {
                travelText = "0 zł (bezpłatny dojazd w Mikołowie)";
            } else if (serviceObj.over200) {
                travelText = `0 zł (gratis przy usłudze powyżej 200 zł w ${cityName})`;
            } else {
                travelText = `30–50 zł (0 zł przy naprawie powyżej 200 zł)`;
            }

            const priceEl = document.getElementById('calc-price-display');
            const travelEl = document.getElementById('calc-travel-display');
            if (priceEl) priceEl.textContent = serviceObj.priceText;
            if (travelEl) travelEl.textContent = `Dojazd: ${travelText}`;

            let message = `Cześć! Zgłoszenie ze strony: ${serviceObj.label}. Miejscowość: ${cityName}.`;
            if (symptoms) {
                message += ` Objawy / sprzęt: ${symptoms}.`;
            }
            message += ` Szacunkowa wycena: ${serviceObj.priceText} (dojazd: ${travelText}). Kiedy mogę zadzwonić lub się umówić?`;

            const previewEl = document.getElementById('calc-message-preview');
            if (previewEl) previewEl.textContent = message;

            return message;
        }

        function updateCalculator() {
            buildMessageData();
        }

        function openWhatsApp() {
            const msg = encodeURIComponent(buildMessageData());
            window.open(`https://wa.me/${CONFIG.phoneInternational}?text=${msg}`, '_blank', 'noopener,noreferrer');
        }

        function openSMS() {
            const msg = encodeURIComponent(buildMessageData());
            window.location.href = `sms:+${CONFIG.phoneInternational}?body=${msg}`;
        }

        /**
         * ===================================================================
         * 4. KOPIOWANIE DO SCHOWKA (EXEC_COMMAND) + POWIADOMIENIE TOAST
         * ===================================================================
         */
        let toastTimer;
        function showToast(text) {
            const box = document.getElementById('toast-box');
            const msg = document.getElementById('toast-message');
            if (!box || !msg) return;

            msg.textContent = text;
            box.classList.remove('translate-y-6', 'opacity-0');
            box.classList.add('translate-y-0', 'opacity-100');

            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                box.classList.remove('translate-y-0', 'opacity-100');
                box.classList.add('translate-y-6', 'opacity-0');
            }, 3000);
        }

        function copyTextToClipboard(text, successLabel) {
            const temp = document.createElement('textarea');
            temp.value = text;
            temp.style.position = 'fixed';
            temp.style.opacity = '0';
            document.body.appendChild(temp);
            temp.select();
            try {
                document.execCommand('copy');
                showToast(successLabel);
            } catch (e) {
                showToast('Nie udało się skopiować.');
            }
            document.body.removeChild(temp);
        }

        function copyPhoneNumber() {
            copyTextToClipboard(CONFIG.phoneDisplay, `Skopiowano numer: ${CONFIG.phoneDisplay}`);
        }

        function copyGeneratedMessage() {
            copyTextToClipboard(buildMessageData(), 'Skopiowano treść zgłoszenia!');
        }

        /**
         * Inicjalizacja aplikacji po załadowaniu DOM
         */
        document.addEventListener('DOMContentLoaded', () => {
            applyConfig();
            updateLiveAvailability();
            updateCalculator();
            setInterval(updateLiveAvailability, 60000);

            const menuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            if (menuBtn && mobileMenu) {
                menuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
                document.querySelectorAll('.mobile-nav-link').forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenu.classList.add('hidden');
                    });
                });
            }
        });
    </script>
</body>
</html>
