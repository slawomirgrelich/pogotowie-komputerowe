        function timeToMinutes(hhmm) {
            const [hours, minutes] = hhmm.split(':').map(Number);
            return hours * 60 + minutes;
        }

        function updateLiveAvailability() {
            const now = new Date();
            const day = now.getDay();
            const currentMinutes = now.getHours() * 60 + now.getMinutes();
            const todayInfo = CONFIG.schedule[day];

            const openMinutes = timeToMinutes(todayInfo.open);
            const closeMinutes = timeToMinutes(todayInfo.close);

            const badge = document.getElementById('live-status-badge');
            const dot = document.getElementById('live-status-dot');
            const textEl = document.getElementById('live-status-text');

            if (currentMinutes >= openMinutes && currentMinutes < closeMinutes) {
                // Serwis aktualnie czynny
